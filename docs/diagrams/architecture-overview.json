  "cards": [
    {
      "dot": "emerald",
      "title": "Read-only by design",
      "items": [
        "No tool creates, updates, publishes, pauses or deletes",
        "One allow-list per platform, checked before every call",
        "Pausing a campaign or uploading feeds stays a human action"
      ]
    },
    {
      "dot": "rose",
      "title": "Credentials",
      "items": [
        "OAuth tokens in the OS keyring by default",
        "Google Ads token kept apart: its scope can write",
        "Merchant and Indexing scopes can write too: treat tokens as sensitive"
      ]
    },
    {
      "dot": "cyan",
      "title": "Configuration",
      "items": [
        "GA4_PROPERTY_ID, GSC_SITE_URL, MERCHANT_ACCOUNT_ID, GTM_CONTAINER_ID",
        "GADS_CUSTOMER_ID, META_AD_ACCOUNT_ID, secrets via set-secret",
        "Any unset service answers not_configured"
      ]
    }
